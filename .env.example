# Neon Postgres pooled connection string (used by the app at runtime)
DATABASE_URL=

# Neon Postgres direct connection string (used by Prisma Migrate only)
DIRECT_URL=

# Secret used to sign session JWTs (any long random string)
JWT_SECRET=

# Base URL of the deployed app, used to build links in emails
APP_URL=http://localhost:3000

# Seat hold time-to-live, in seconds
HOLD_TTL_SECONDS=600

# Waitlist offer time-to-live, in seconds
WAITLIST_OFFER_TTL_SECONDS=900

# Bearer token required by POST /api/cron/sweep
CRON_SECRET=

# Invite code required to self-register with role=ORGANISER
ORGANISER_SIGNUP_CODE=

# Gmail SMTP credentials for booking confirmation emails
GMAIL_USER=
GMAIL_APP_PASSWORD=

# When true, emails are logged instead of sent (no Gmail credentials required)
MAIL_DRY_RUN=true

# Secret used to HMAC-sign the booking reference encoded in ticket QR codes
QR_SIGNING_SECRET=

# Optional: override the SMTP host (defaults to smtp.gmail.com). Used by
# scripts/booking-test.ts to point at an unreachable host and prove email
# failures never fail a booking.
SMTP_HOST=

# Optional: when set, the seed script uses this address for alice, bob and
# carol instead of their @ticketing.test placeholders, so a grader cancelling
# a seeded booking actually receives the waitlist offer email. Falls back to
# @ticketing.test (which does not accept mail) when unset.
DEMO_RECIPIENT_EMAIL=

# Gates /demo and its API routes (POST /api/demo/race, /api/demo/waitlist-cascade).
# Off by default; the demo routes self-provision their own fixtures, so this
# is safe to leave on in a public demo deployment.
ENABLE_DEMO_ROUTES=false

# Gates POST /api/demo/reset, which wipes and re-provisions the demo fixtures.
DEMO_RESET_ENABLED=false
